diff --git a/vm/src/handlers/get_metrics.rs b/vm/src/handlers/get_metrics.rs
index 1f76cd2..99146a3 100644
--- a/vm/src/handlers/get_metrics.rs
+++ b/vm/src/handlers/get_metrics.rs
@@ -6,6 +6,63 @@ use common::metrics::VAppMetrics;
 /// Global storage for the last V-App's metrics
 static mut LAST_VAPP_METRICS: VAppMetrics = VAppMetrics::new();
 
+/// Counters of the V-App that is currently running. Unlike `LAST_VAPP_METRICS`, these are
+/// updated while the V-App runs, so that they can be read every time it is interrupted.
+static mut LIVE_VAPP_METRICS: VAppMetrics = VAppMetrics::new();
+
+/// Resets the live counters; called when a V-App starts.
+pub fn live_start(vapp_name: &[u8], vapp_hash: [u8; 32]) {
+    let mut metrics = VAppMetrics::new();
+    let copy_len = vapp_name.len().min(metrics.vapp_name.len());
+    metrics.vapp_name[..copy_len].copy_from_slice(&vapp_name[..copy_len]);
+    metrics.vapp_hash = vapp_hash;
+    unsafe {
+        LIVE_VAPP_METRICS = metrics;
+    }
+}
+
+#[inline(always)]
+pub fn live_count_instruction() {
+    unsafe {
+        LIVE_VAPP_METRICS.instruction_count += 1;
+    }
+}
+
+#[inline(always)]
+pub fn live_count_page_load() {
+    unsafe {
+        LIVE_VAPP_METRICS.page_loads += 1;
+    }
+}
+
+#[inline(always)]
+pub fn live_count_page_commit() {
+    unsafe {
+        LIVE_VAPP_METRICS.page_commits += 1;
+    }
+}
+
+/// Replies to a GetMetrics command received while the V-App is interrupted (that is, when the
+/// VM is waiting for the client's `Continue`) with the live counters, in the same 80-byte format
+/// as [`handler_get_metrics`]. Returns the `Comm`, so that the caller can keep waiting.
+pub fn reply_live_metrics<'a, const N: usize>(
+    command: ledger_device_sdk::io::Command<'a, N>,
+) -> &'a mut ledger_device_sdk::io::Comm<N> {
+    let metrics = unsafe { LIVE_VAPP_METRICS };
+
+    let mut response = command.into_response();
+    response.append(&metrics.vapp_name).unwrap();
+    response.append(&metrics.vapp_hash).unwrap();
+    response
+        .append(&metrics.instruction_count.to_be_bytes())
+        .unwrap();
+    response.append(&metrics.page_loads.to_be_bytes()).unwrap();
+    response
+        .append(&metrics.page_commits.to_be_bytes())
+        .unwrap();
+    response.send(AppSW::Ok).unwrap()
+}
+
 /// Sets the metrics for the last executed V-App.
 /// # Safety
 /// This function is not thread-safe, but is safe in the single-threaded Ledger environment.
