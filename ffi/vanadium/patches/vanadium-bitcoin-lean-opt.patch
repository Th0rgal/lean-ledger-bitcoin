+        let parsed = Psbt::parse(&v).unwrap();
+        let txout = parsed.inputs[0].get_witness_utxo().unwrap().unwrap();
+        assert_eq!(txout.value.to_sat(), 50_000);
+        assert_eq!(txout.script_pubkey.len(), 300);
+    }
 }
