+        // Sane `andor` policy registers and derives cleanly.
+        let sane = WalletPolicy::new(
+            "wsh(andor(pk(@0/**),older(100),pk(@1/**)))",
+            vec![xpub0.try_into().unwrap(), xpub1.try_into().unwrap()],
